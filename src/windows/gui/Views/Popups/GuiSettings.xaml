<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="560" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="18">
        <TextBlock Name="TxtLead" TextWrapping="Wrap" FontWeight="SemiBold"/>
        <TextBlock Margin="0,12,0,0" Text="Font family:"/>
        <ComboBox Name="LstGuiFonts" Margin="0,6,0,0"/>
        <Button Name="BtnGuiFontUpload" Content="Upload a font file..." Margin="0,6,0,0" HorizontalAlignment="Left"/>
        <TextBlock Margin="0,10,0,0" Text="Font size:"/>
        <ComboBox Name="LstGuiSizes" Margin="0,6,0,0" Width="120" HorizontalAlignment="Left"/>
        <TextBlock Margin="0,10,0,0" Text="Theme:"/>
        <ComboBox Name="LstGuiColours" Margin="0,6,0,0" Width="200" HorizontalAlignment="Left"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Name="BtnGuiCancel" Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True"
                    Style="{DynamicResource BtnCancel}"/>
            <Button Name="BtnGuiApply" Content="APPLY" Width="90" IsDefault="True"
                    Style="{DynamicResource BtnApply}"/>
        </StackPanel>
    </StackPanel>
</Window>
