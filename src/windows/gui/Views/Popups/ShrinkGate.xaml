<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compact instance" Width="540" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="18">
        <TextBlock Name="TxtLead" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>
        <TextBlock Margin="0,10,0,0" Text="WARNING: THE INSTANCE WILL BE STOPPED." FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AppWarningBrush}"/>
        <TextBlock Margin="0,10,0,10" TextWrapping="Wrap">Make sure nothing is running inside.</TextBlock>
        <CheckBox Name="ChkArchive" TabIndex="0" Margin="0,12,0,0" Content="Archive it first"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Name="BtnGateCancel" TabIndex="1" Content="Cancel" Width="80" Height="28" Margin="0,0,8,0" IsCancel="True"
                    Style="{DynamicResource BtnCancel}"/>
            <Button Name="BtnGateCompact" TabIndex="2" Content="COMPACT" Width="90" Height="28" IsDefault="True"
                    Style="{DynamicResource BtnApply}"/>
        </StackPanel>
    </StackPanel>
</Window>
