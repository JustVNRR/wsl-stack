# ==============================================================================
# PYTHON - SHARED DEFAULTS (the python pack)
# ==============================================================================
# The template the scaffolding targets use when they are called directly, by
# name. `fnew` never reads it: it always picks from the catalogs interactively.
#
# `gmake env_global_enable` copies this block into
# ~/.config/zsh/gmake/.env.global the first time it runs; after that it only
# adds what is missing.
#
# Nothing reads this file: it is a sample. The filled copy in .env.global is
# what gmake loads.
#
# The two template lines stay commented out on purpose: a commented line does
# not travel into .env.global, so leaving them out means "unset, and the target
# will ask". TEMPLATE_PACK is the other kind: it is set, because a direct call
# without it would copy the project and run nothing else.
# ==============================================================================

# --- Which pack's step runs after a direct copier_project/cruft_project ---
# A row picked by `fnew` carries the pack that curates it, and that pack's step
# follows the copy on its own. Called by name, the target has no row to read:
# this is what names the pack. `python` is the pack whose step is `init_venv`.
TEMPLATE_PACK=python

# --- Optional default template for direct copier_project/cruft_project calls ---
# PROJECT_TEMPLATE_REPO=
# PROJECT_TEMPLATE_VERSION=
