# ==============================================================================
# THE PACKAGE AND ITS CONTAINER - THIS PROJECT (the devops pack)
# ==============================================================================
# What the local docker targets read. `gmake env_project_enable` copies this
# block into the project's .env the first time it runs; after that it only adds
# what is missing, so a value you filled in is never overwritten.
#
# Nothing reads this file: it is a sample. The project's .env is what gmake
# loads.
# ==============================================================================

# --- The application package and its container ---
# Example: PACKAGE_NAME=my-package
PACKAGE_NAME=
# Example: DOCKER_BASE_IMAGE=python:3.10.6-slim
DOCKER_BASE_IMAGE=
# Example: DOCKER_LOCAL_IMAGE=my_project-image
DOCKER_LOCAL_IMAGE=
