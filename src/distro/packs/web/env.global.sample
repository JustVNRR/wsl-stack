# ==============================================================================
# THE TUNNEL - SHARED DEFAULTS (the web pack)
# ==============================================================================
# Read by the vpn_* targets and by the boot hook. `gmake env_global_enable`
# copies this block into ~/.config/zsh/gmake/.env.global (first run), then only
# adds what is missing. Values of the machine, not of a project.
# ==============================================================================

# Which server the tunnel uses, and the distro starts with: an id of
# ~/.config/vpn/servers.json (gmake vpn_server picks one and writes it here).
VPN_PROFILE=server-1

# BASE_DNS: what the instance resolves with while no tunnel is up - the
# tunnel's own DNS belongs to the server, in its entry of servers.json.
# VPN_MTU: for every server whose entry says nothing (an entry's "mtu" wins).
BASE_DNS=1.1.1.1
VPN_MTU=1420

# true: two iptables rules in the profile reject whatever would leave outside
# the tunnel, scoped to this instance. `gmake vpn_ks_on`/`vpn_ks_off` write
# this line and remount (ks_off also sweeps leftovers).
VPN_KILL_SWITCH=true
