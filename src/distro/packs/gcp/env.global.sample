# ==============================================================================
# GOOGLE CLOUD - SHARED DEFAULTS (the gcp pack)
# ==============================================================================
# What the Google Cloud targets need, on every project: mostly a place on the
# planet. `gmake env_global_enable` copies this block into
# ~/.config/zsh/gmake/.env.global the first time it runs; after that it only
# adds what is missing.
#
# Nothing reads this file: it is a sample. The filled copy in .env.global is
# what gmake loads.
# ==============================================================================

# --- Geographic defaults (the same for all your projects) ---
# Example: GCP_REGION=europe-west1
GCP_REGION=
# Example: ZONE=europe-west1-b
ZONE=
# Where BigQuery datasets live. EU keeps the data in Europe, which is what a
# project with European users wants; a dataset cannot be moved afterwards.
BQ_REGION=EU

# --- VM image defaults (generic — keep the values) ---
IMAGE_FAMILY=ubuntu-2204-lts
IMAGE_PROJECT=ubuntu-os-cloud

# --- Memory given to the deployed Cloud Run service ---
# Passed to `gcloud run deploy --memory`. 512Mi is Google's own default, so a
# project that needs nothing in particular can leave this line alone; one that
# needs more sets its own value in its .env, which wins over this one.
CLOUDRUN_MEMORY=512Mi

# --- GCP SDK: one key for all your work (optional) ---
# The service-account key the Python libraries read. Absolute path, outside
# this repository: it is a password, and it is worth nothing in a git log.
# Example: GOOGLE_APPLICATION_CREDENTIALS=/home/you/keys/gcp-key.json
# GOOGLE_APPLICATION_CREDENTIALS=
