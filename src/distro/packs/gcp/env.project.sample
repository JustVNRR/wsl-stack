# ==============================================================================
# GOOGLE CLOUD - THIS PROJECT (the gcp pack)
# ==============================================================================
# What identifies this project on Google Cloud. `gmake env_project_enable`
# copies this block into the project's .env the first time it runs; after that
# it only adds what is missing, so a value you filled in is never overwritten.
#
# Nothing reads this file: it is a sample. The project's .env is what gmake
# loads — and what the Python code reads, through load_dotenv.
# ==============================================================================

# --- GCP identity (required by most targets) ---
# Example: GCP_PROJECT=my-project-id
GCP_PROJECT=

# --- Compute Engine (VM) ---
# Example: INSTANCE=my-vm-instance
INSTANCE=
# Example: MACHINE_TYPE=e2-standard-2
MACHINE_TYPE=
# Example: SA_NAME=my-project-vm-sa
SA_NAME=
# Script sent to the VM by gmake vm_run_script (path relative to the project root)
# Example: VM_SCRIPT=scripts/setup_vm.sh
VM_SCRIPT=

# --- Storage & BigQuery ---
# Example: BUCKET_NAME=my-data-bucket
BUCKET_NAME=
# Example: BQ_DATASET=my_dataset
BQ_DATASET=
# Optional, for table-level targets
# Example: TABLE_NAME=my_table
TABLE_NAME=

# --- The deployed image and where it lives ---
# Example: GAR_IMAGE=my-api
GAR_IMAGE=
# Example: ARTIFACTSREPO=my-artifacts
ARTIFACTSREPO=
# Cloud Run access: leave empty for a private service (authenticated
# invocations), set to true to expose a public URL (e.g. demos)
CLOUDRUN_PUBLIC=
# Populated after deployment (gmake cloudrun_url), read by the Cloud API tests
# Example: SERVICE_URL=https://my-api-123456789-ew.a.run.app
SERVICE_URL=
