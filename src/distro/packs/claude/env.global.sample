# ==============================================================================
# CLAUDE - SHARED DEFAULTS (the claude pack)
# ==============================================================================
# Which provider this instance talks to - the id of an entry in the dictionary
# the pack seeded at ~/.config/claude/profiles.json, which `gmake claude_profile`
# writes here when you choose one, and `gmake claude_edit_profiles` opens.
#
# `gmake env_global_enable` copies this block into
# ~/.config/zsh/gmake/.env.global the first time it runs; after that it only
# adds what is missing. This file is a sample - .env.global is what gmake loads.
# ==============================================================================

# --- Which provider this instance talks to ---
# `gmake claude_profile` chooses from the dictionary, or takes a name on the
# command line (gmake claude_profile CLAUDE_PROFILE=gateway). The dictionary is
# the source: a token changed there is written again by the next claude_profile.
CLAUDE_PROFILE=claude
