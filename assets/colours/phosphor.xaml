<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The phosphor theme - the window's chart as it shipped, in its two
         versions. Every key replaces the same key of theme.xaml when this
         theme is chosen or its version switched; a key left out keeps the
         default's. The reds stay put on purpose - they mean "destructive"
         whatever the phosphor. -->
    <ResourceDictionary x:Key="Dark">
        <SolidColorBrush x:Key="AppForegroundBrush" Color="#33FF66"/>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="AppFrameBrush" Color="#1F9E4C"/>
        <Color x:Key="AppGlowColor">#33FF66</Color>
        <SolidColorBrush x:Key="AppSurfaceBrush" Color="#252526"/>
        <SolidColorBrush x:Key="AppInputBackgroundBrush" Color="#2D2D30"/>
        <SolidColorBrush x:Key="AppFaceBrush" Color="#333337"/>
        <SolidColorBrush x:Key="AppStripeBrush" Color="#2A2A2D"/>
        <SolidColorBrush x:Key="AppMutedBrush" Color="#2F9E55"/>
        <SolidColorBrush x:Key="AppBorderBrush" Color="#555555"/>
        <SolidColorBrush x:Key="AppDividerBrush" Color="#3F3F46"/>
        <SolidColorBrush x:Key="AppSelectionBrush" Color="#14532D"/>
        <SolidColorBrush x:Key="AppSelectionInkBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AppNewsBrush" Color="#3FAE5F"/>
        <SolidColorBrush x:Key="AppWarningBrush" Color="#D7BA7D"/>
        <SolidColorBrush x:Key="AppDangerBrush" Color="#E04040"/>
        <SolidColorBrush x:Key="AppSoftDangerBrush" Color="#C05050"/>
        <SolidColorBrush x:Key="AppDeleteBrush" Color="#A1260D"/>
        <SolidColorBrush x:Key="AppDeleteBorderBrush" Color="#BB2D0F"/>
        <SolidColorBrush x:Key="AppDeleteInkBrush" Color="#FFFFFF"/>
    </ResourceDictionary>

    <!-- The light version: deep green ink on cream paper - the phosphor
         identity read off a printout. -->
    <ResourceDictionary x:Key="Light">
        <SolidColorBrush x:Key="AppForegroundBrush" Color="#145C28"/>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F2EFE4"/>
        <SolidColorBrush x:Key="AppFrameBrush" Color="#4A8F5E"/>
        <Color x:Key="AppGlowColor">#145C28</Color>
        <SolidColorBrush x:Key="AppSurfaceBrush" Color="#E8E5D6"/>
        <SolidColorBrush x:Key="AppInputBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AppFaceBrush" Color="#E3DECC"/>
        <SolidColorBrush x:Key="AppStripeBrush" Color="#DFDAC7"/>
        <SolidColorBrush x:Key="AppMutedBrush" Color="#4A7454"/>
        <SolidColorBrush x:Key="AppBorderBrush" Color="#B5AE96"/>
        <SolidColorBrush x:Key="AppDividerBrush" Color="#CFC9B4"/>
        <SolidColorBrush x:Key="AppSelectionBrush" Color="#BBDDC2"/>
        <SolidColorBrush x:Key="AppSelectionInkBrush" Color="#123A1E"/>
        <SolidColorBrush x:Key="AppNewsBrush" Color="#186533"/>
        <SolidColorBrush x:Key="AppWarningBrush" Color="#855A19"/>
        <SolidColorBrush x:Key="AppDangerBrush" Color="#C22F2F"/>
        <SolidColorBrush x:Key="AppSoftDangerBrush" Color="#B04A4A"/>
        <SolidColorBrush x:Key="AppDeleteBrush" Color="#A1260D"/>
        <SolidColorBrush x:Key="AppDeleteBorderBrush" Color="#BB2D0F"/>
        <SolidColorBrush x:Key="AppDeleteInkBrush" Color="#FFFFFF"/>
    </ResourceDictionary>
</ResourceDictionary>
