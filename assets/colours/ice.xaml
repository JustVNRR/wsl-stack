<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The ice theme - a cold blue phosphor, in its two versions. Every
         key replaces the same key of theme.xaml when this theme is chosen
         or its version switched; a key left out keeps the default's. The
         reds stay put on purpose - they mean "destructive" whatever the
         phosphor. -->
    <ResourceDictionary x:Key="Dark">
        <SolidColorBrush x:Key="AppForegroundBrush" Color="#66D9FF"/>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#10161C"/>
        <SolidColorBrush x:Key="AppFrameBrush" Color="#1F7E9E"/>
        <Color x:Key="AppGlowColor">#66D9FF</Color>
        <SolidColorBrush x:Key="AppSurfaceBrush" Color="#1A2229"/>
        <SolidColorBrush x:Key="AppInputBackgroundBrush" Color="#1F2A33"/>
        <SolidColorBrush x:Key="AppFaceBrush" Color="#27343E"/>
        <SolidColorBrush x:Key="AppStripeBrush" Color="#1E272E"/>
        <SolidColorBrush x:Key="AppMutedBrush" Color="#3F8FA8"/>
        <SolidColorBrush x:Key="AppBorderBrush" Color="#3F4E5A"/>
        <SolidColorBrush x:Key="AppDividerBrush" Color="#2F3B45"/>
        <SolidColorBrush x:Key="AppSelectionBrush" Color="#124A5E"/>
        <SolidColorBrush x:Key="AppSelectionInkBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AppNewsBrush" Color="#3FAE9F"/>
        <SolidColorBrush x:Key="AppWarningBrush" Color="#D7BA7D"/>
        <SolidColorBrush x:Key="AppDangerBrush" Color="#E04040"/>
        <SolidColorBrush x:Key="AppSoftDangerBrush" Color="#C05050"/>
        <SolidColorBrush x:Key="AppDeleteBrush" Color="#A1260D"/>
        <SolidColorBrush x:Key="AppDeleteBorderBrush" Color="#BB2D0F"/>
        <SolidColorBrush x:Key="AppDeleteInkBrush" Color="#FFFFFF"/>
    </ResourceDictionary>

    <!-- The light version: petrol ink on pale ice. -->
    <ResourceDictionary x:Key="Light">
        <SolidColorBrush x:Key="AppForegroundBrush" Color="#074A66"/>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#EAF2F5"/>
        <SolidColorBrush x:Key="AppFrameBrush" Color="#4E93AE"/>
        <Color x:Key="AppGlowColor">#074A66</Color>
        <SolidColorBrush x:Key="AppSurfaceBrush" Color="#DEE9EE"/>
        <SolidColorBrush x:Key="AppInputBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AppFaceBrush" Color="#DCE8ED"/>
        <SolidColorBrush x:Key="AppStripeBrush" Color="#D8E4EA"/>
        <SolidColorBrush x:Key="AppMutedBrush" Color="#3E6877"/>
        <SolidColorBrush x:Key="AppBorderBrush" Color="#A8BEC7"/>
        <SolidColorBrush x:Key="AppDividerBrush" Color="#C6D6DC"/>
        <SolidColorBrush x:Key="AppSelectionBrush" Color="#BBDCEC"/>
        <SolidColorBrush x:Key="AppSelectionInkBrush" Color="#073B52"/>
        <SolidColorBrush x:Key="AppNewsBrush" Color="#19654C"/>
        <SolidColorBrush x:Key="AppWarningBrush" Color="#7A5A1A"/>
        <SolidColorBrush x:Key="AppDangerBrush" Color="#C22F2F"/>
        <SolidColorBrush x:Key="AppSoftDangerBrush" Color="#B04A4A"/>
        <SolidColorBrush x:Key="AppDeleteBrush" Color="#A1260D"/>
        <SolidColorBrush x:Key="AppDeleteBorderBrush" Color="#BB2D0F"/>
        <SolidColorBrush x:Key="AppDeleteInkBrush" Color="#FFFFFF"/>
    </ResourceDictionary>
</ResourceDictionary>
